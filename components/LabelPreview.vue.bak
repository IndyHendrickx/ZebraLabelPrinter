<script setup lang="ts">
import { computed } from 'vue'

interface Form {
  type : 'food' | 'storage' | 'reminder' | 'unknown'
  size : 'normal' | 'compact'
  date : string
  item : string
}

const props   = defineProps<{ data: Form }>()
const logoSrc = computed(() => `/logos/${props.data.type}.svg`)
</script>

<template>
  <div class="border rounded p-3 bg-white shadow text-sm leading-tight">

    <!-- SMALL: two half-labels ---------------------------------------- -->
    <template v-if="props.data.size === 'compact'">
      <div v-for="i in 2" :key="i">
        <div class="flex gap-2 items-start">
          <img :src="logoSrc" class="w-12" />
          <div>
            <div class="font-xl font-bold uppercase">{{ props.data.item }}</div>
            <div class="text-xs font-bold uppercase">DATE {{ props.data.date }}</div>
          </div>
        </div>
        <hr v-if="i === 1" class="my-1 border-dashed">
      </div>
    </template>

    <!-- BIG: full-height label ---------------------------------------- -->
    <template v-else>
      <div class="flex gap-2 items-start">
        <img :src="logoSrc" class="w-12" />
        <div>
          <div class="text-xl font-bold uppercase">{{ props.data.item }}</div>
          <div class="text-xs fond-bold uppercase">DATE {{ props.data.date }}</div>
        </div>
      </div>
    </template>

  </div>
</template>
